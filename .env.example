APP_NAME=ContractSense
APP_ENV=development
# Change this before exposing the API to a network.
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_HOURS=12

# sqlite is ready to use without MongoDB. Set DB_BACKEND=mongodb and provide a URI to use MongoDB.
DB_BACKEND=sqlite
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lexintel
DATA_DIR=./storage
MAX_UPLOAD_MB=25

# mock gives evidence-only local responses. Supported: mock, gemini, groq, ollama.
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional fine-tuned Hugging Face sequence-classification checkpoint, not a base LegalBERT model.
LEGALBERT_MODEL_PATH=
ENABLE_CHROMA=true
# Same-origin clients need no CORS. Add comma-separated origins only for cross-origin clients.
CORS_ORIGINS=
OCR_LANGUAGE=eng
